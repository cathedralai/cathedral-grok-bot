# Copy to .env and fill in. Never commit .env.

# Cathedral: an API key (https://cathedral.computer/account/) ...
CATHEDRAL_API_KEY=
# ... OR pay with Gamma from your own hotkey (no account). Leave CATHEDRAL_API_KEY empty then.
# Needs: pip install bittensor-wallet
CATHEDRAL_WALLET=
CATHEDRAL_HOTKEY=
# CATHEDRAL_WALLET_PATH=~/.bittensor/wallets

# Chutes inference (https://chutes.ai)
CHUTES_API_KEY=
# CHUTES_MODEL=deepseek-ai/DeepSeek-V3.2-TEE

# X API v2, OAuth 1.0a user context of the bot account (Read and Write app permission).
# Leave empty and run with --mock to test without X.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
X_BOT_USERNAME=yourbot

# Optional: Brave Search API key for better web search (free tier at https://brave.com/search/api/).
# Sent only to the search command in the room, never to model-written code. Without it: DuckDuckGo, then Wikipedia.
# BRAVE_API_KEY=

# Optional
# POLL_SECONDS=60
# ANSWERS_PER_AUTHOR_PER_HOUR=5
# ANSWERS_PER_HOUR=200
# CATHEDRAL_TEMPLATE=sealed-1x2
# CATHEDRAL_ROOM_SECONDS=600
# CATHEDRAL_ROOM_MAX_USD=0.002
